{
  "name": "ohttp-relay",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "build": "mkdir -p dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "node --experimental-strip-types src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test api netlify",
    "format": "biome format --write src test api netlify"
  },
  "dependencies": {
    "ohttp-ts": "^0.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8",
    "wrangler": "^4.124.0"
  }
}
